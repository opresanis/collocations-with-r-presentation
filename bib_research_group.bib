@InCollection{Schweinberger2026,
  author    = {Martin Schweinberger},
  booktitle = {Reference Module in Social Sciences},
  date      = {2026},
  title     = {Reproducibility in Corpus Linguistics},
  doi       = {https://doi.org/10.1016/B978-0-323-95504-1.00967-4},
  isbn      = {978-0-443-15785-1},
  publisher = {Elsevier},
  url       = {https://www.sciencedirect.com/science/article/pii/B9780323955041009674},
  abstract  = {Reproducibility has become essential in corpus linguistics as the field increasingly relies on large datasets, computational methods, and complex statistical analyses. This article examines reproducibility's conceptual foundations, practical challenges, and potential solutions in corpus linguistics research. It distinguishes reproducibility from replicability and demonstrates how reproducibility enables transparency, error detection, and cumulative knowledge building. The article identifies key barriers—including restricted data access, non-standardized workflows, and inadequate documentation—and proposes solutions aligned with FAIR data principles: rigorous data management, transparent annotation practices, reproducible computational environments, and version control. Achieving reproducibility requires both technical strategies and institutional reforms, including changes to publishing practices and enhanced training.},
  keywords  = {Reproducibility, Replication, Generalizability, Accountability, Data management},
}

